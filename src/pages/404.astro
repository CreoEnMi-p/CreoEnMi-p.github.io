---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title='页面没有找到' description='请求的页面不存在。' pageClass='not-found-page'>
	<section class='not-found'>
		<p class='error-code'>404</p>
		<h1>这一页没有留下来</h1>
		<p>它可能被移动、删除，或者从未存在。</p>
		<a class='text-link' href='/'>回到首页 <span aria-hidden='true'>→</span></a>
	</section>
</BaseLayout>

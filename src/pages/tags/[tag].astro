---
import EmptyState from '../../components/EmptyState.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags, getVisiblePosts } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	return [...getAllTags(posts).keys()].map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts.filter((post) => post.data.tags.includes(tag)),
		},
	}));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`所有标记为“${tag}”的文章。`}>
	<header class='page-header'>
		<p class='section-kicker'>Tagged</p>
		<h1>{tag}</h1>
		<p>{posts.length} 篇文章</p>
	</header>
	{
		posts.length > 0 ? (
			<PostList posts={posts} />
		) : (
			<EmptyState title='暂无文章' description='这个标签下还没有公开内容。' />
		)
	}
</BaseLayout>

---
import { getPostHref, getVisiblePosts } from '../lib/posts';

const posts = await getVisiblePosts();
const searchData = posts.map((post) => ({
	title: post.data.title,
	description: post.data.summary || post.data.description || '',
	tags: post.data.tags,
	date: post.data.pubDate.toISOString(),
	href: getPostHref(post),
}));
---

<dialog id='search-modal' class='search-modal' aria-labelledby='search-title'>
	<div class='search-modal-header'>
		<div>
			<p class='section-kicker'>Find a note</p>
			<h2 id='search-title'>搜索文章</h2>
		</div>
		<button type='button' id='close-search-modal' class='close-search' aria-label='关闭搜索'>×</button>
	</div>
	<label class='search-box'>
		<span class='sr-only'>输入关键词</span>
		<svg aria-hidden='true' viewBox='0 0 24 24' width='19' height='19'>
			<circle cx='11' cy='11' r='7'></circle>
			<path d='m16.5 16.5 4 4'></path>
		</svg>
		<input id='modal-search-input' type='search' placeholder='搜索标题、摘要或标签…' autocomplete='off' />
	</label>
	<div id='modal-search-results' class='search-results' aria-live='polite'>
		<p class='search-tip'>输入关键词开始搜索，按 <kbd>Esc</kbd> 关闭。</p>
	</div>
</dialog>

<script is:inline define:vars={{ searchData }}>
	function initSearchModal() {
		const modal = document.getElementById('search-modal');
		const input = document.getElementById('modal-search-input');
		const results = document.getElementById('modal-search-results');
		const closeButton = document.getElementById('close-search-modal');
		if (!modal || !input || !results || !closeButton || modal.dataset.ready === 'true') return;
		modal.dataset.ready = 'true';

		const formatDate = (value) =>
			new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
				.format(new Date(value))
				.replaceAll('/', '.');

		const showTip = (message) => {
			results.replaceChildren();
			const tip = document.createElement('p');
			tip.className = 'search-tip';
			tip.textContent = message;
			results.append(tip);
		};

		const renderResults = (query) => {
			const keyword = query.trim().toLocaleLowerCase('zh-CN');
			if (!keyword) {
				showTip('输入关键词开始搜索，按 Esc 关闭。');
				return;
			}

			const matches = searchData.filter((post) =>
				[post.title, post.description, ...post.tags].some((value) =>
					value.toLocaleLowerCase('zh-CN').includes(keyword),
				),
			);

			if (!matches.length) {
				showTip('没有找到匹配的文章。');
				return;
			}

			const fragment = document.createDocumentFragment();
			for (const post of matches) {
				const item = document.createElement('article');
				item.className = 'search-result';

				const date = document.createElement('time');
				date.dateTime = post.date;
				date.textContent = formatDate(post.date);

				const link = document.createElement('a');
				link.href = post.href;
				link.textContent = post.title;

				const summary = document.createElement('p');
				summary.textContent = post.description;

				item.append(date, link);
				if (post.description) item.append(summary);
				fragment.append(item);
			}
			results.replaceChildren(fragment);
		};

		window.openSearchModal = () => {
			if (!modal.open) modal.showModal();
			window.setTimeout(() => input.focus(), 50);
		};

		closeButton.addEventListener('click', () => modal.close());
		modal.addEventListener('click', (event) => {
			if (event.target === modal) modal.close();
		});
		input.addEventListener('input', () => renderResults(input.value));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && modal.open) {
				event.preventDefault();
				modal.close();
				return;
			}

			if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
				event.preventDefault();
				window.openSearchModal();
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initSearchModal);
	} else {
		initSearchModal();
	}
</script>
